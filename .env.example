LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_HOST=http://localhost:11434

# FinSight uses separate settings from the original learning chat.
FINSIGHT_DATA_DIR=data/finsight
FINSIGHT_PROVIDER=ollama
FINSIGHT_MODEL=qwen3:8b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Qwen API is separate from local Ollama Qwen models; match your key's region.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
