<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.finsight.daily</string>
  <key>ProgramArguments</key><array>
    <string>/absolute/path/finsight-agent/.venv/bin/finsight</string>
    <string>watch</string><string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>/absolute/path/finsight-agent</string>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
  <key>StandardOutPath</key><string>/absolute/path/finsight-agent/data/finsight-watch.log</string>
  <key>StandardErrorPath</key><string>/absolute/path/finsight-agent/data/finsight-watch.log</string>
</dict></plist>
